{
  "rules": {
    ".read": false,
    ".write": false,
    "activeSession": {
      ".read": "auth != null",
      ".write": "auth != null && newData.hasChildren(['roomKey', 'hostUid']) && newData.child('hostUid').val() === auth.uid && root.child('rooms').child(newData.child('roomKey').val()).child('hostUid').val() === auth.uid",
      "roomKey": {
        ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{36}$/)"
      },
      "hostUid": {
        ".validate": "newData.isString() && newData.val().length <= 128"
      }
    },
    "characterPool": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('creatorUid').val() === auth.uid && newData.child('activeUid').val() === auth.uid) || (data.exists() && newData.exists() && newData.child('creatorUid').val() === data.child('creatorUid').val() && (data.child('activeUid').val() === auth.uid || (!data.child('activeUid').exists() && newData.child('activeUid').val() === auth.uid) || (data.child('activeUid').val() === '' && newData.child('activeUid').val() === auth.uid) || (root.child('activeSession').child('roomKey').val() !== data.child('activeRoom').val() && newData.child('activeUid').val() === auth.uid) || root.child('rooms').child(newData.child('adminRoom').val()).child('hostUid').val() === auth.uid)) || (data.exists() && !newData.exists() && root.child('rooms').child(data.child('adminRoom').val()).child('hostUid').val() === auth.uid))"
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null && $room.matches(/^[a-f0-9]{36}$/)",
        ".write": "auth != null && $room.matches(/^[a-f0-9]{36}$/) && ((!data.exists() && newData.child('hostUid').val() === auth.uid && newData.child('rulesVersion').val() === 4) || (data.exists() && data.child('hostUid').val() === auth.uid))",
        "hostUid": {
          ".validate": "newData.val() === data.val() || (!data.exists() && newData.val() === auth.uid)"
        },
        "rulesVersion": {
          ".validate": "newData.val() === 4"
        },
        "heroes": {
          "$slot": {
            ".write": "auth != null && (root.child('rooms').child($room).child('hostUid').val() === auth.uid || data.child('owner').val() === auth.uid || (!data.child('owner').exists() && newData.child('owner').val() === auth.uid) || (data.child('owner').val() === '' && newData.child('owner').val() === auth.uid))",
            "owner": {
              ".write": "auth != null && root.child('rooms').child($room).child('heroes').child($slot).exists() && (data.val() === auth.uid || ((!data.exists() || data.val() === '') && newData.val() === auth.uid))",
              ".validate": "newData.isString() && newData.val().length <= 128 && (data.val() === newData.val() || !data.exists() || data.val() === '' || newData.val() === '')"
            },
            "stats": {
              ".write": "auth != null && (root.child('rooms').child($room).child('hostUid').val() === auth.uid || root.child('rooms').child($room).child('heroes').child($slot).child('owner').val() === auth.uid)",
              "$stat": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15 && newData.val() % 1 === 0"
              }
            },
            "xp": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000 && ((!data.exists() && newData.val() === 0) || data.val() === newData.val() || root.child('rooms').child($room).child('hostUid').val() === auth.uid)"
            },
            "gold": {
              ".write": "auth != null && (root.child('rooms').child($room).child('hostUid').val() === auth.uid || root.child('rooms').child($room).child('heroes').child($slot).child('owner').val() === auth.uid)",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
            },
            "hp": {
              ".write": "auth != null && (root.child('rooms').child($room).child('hostUid').val() === auth.uid || root.child('rooms').child($room).child('heroes').child($slot).child('owner').val() === auth.uid)",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 38"
            },
            "weaponId": {
              ".write": "auth != null && (root.child('rooms').child($room).child('hostUid').val() === auth.uid || root.child('rooms').child($room).child('heroes').child($slot).child('owner').val() === auth.uid)",
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 36 && newData.val() % 1 === 0"
            },
            "armorId": {
              ".write": "auth != null && (root.child('rooms').child($room).child('hostUid').val() === auth.uid || root.child('rooms').child($room).child('heroes').child($slot).child('owner').val() === auth.uid)",
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 14 && newData.val() % 1 === 0"
            },
            "ownedWeapons": {
              "$id": {
                ".write": "auth != null && (root.child('rooms').child($room).child('hostUid').val() === auth.uid || root.child('rooms').child($room).child('heroes').child($slot).child('owner').val() === auth.uid)",
                ".validate": "newData.val() === true || newData.val() === 1"
              }
            },
            "ownedArmors": {
              "$id": {
                ".write": "auth != null && (root.child('rooms').child($room).child('hostUid').val() === auth.uid || root.child('rooms').child($room).child('heroes').child($slot).child('owner').val() === auth.uid)",
                ".validate": "newData.val() === true || newData.val() === 1"
              }
            },
            "potions": {
              "$id": {
                ".write": "auth != null && (root.child('rooms').child($room).child('hostUid').val() === auth.uid || root.child('rooms').child($room).child('heroes').child($slot).child('owner').val() === auth.uid)",
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99 && newData.val() % 1 === 0 && $id.matches(/^[0-9]$/)"
              }
            },
            "activeBoosts": {
              "$stat": {
                ".write": "auth != null && (root.child('rooms').child($room).child('hostUid').val() === auth.uid || root.child('rooms').child($room).child('heroes').child($slot).child('owner').val() === auth.uid)",
                ".validate": "newData.val() === 1"
              }
            },
            "inventory": {
              ".validate": "newData.isString() && newData.val().length <= 1500"
            },
            "notes": {
              ".validate": "newData.isString() && newData.val().length <= 1500"
            },
            "druidTalisman": {
              ".validate": "newData.isBoolean()",
              ".write": "auth != null && root.child('rooms').child($room).child('hostUid').val() === auth.uid"
            },
            "ownedAccessories": {
              "$id": {
                ".write": "auth != null && (root.child('rooms').child($room).child('hostUid').val() === auth.uid || root.child('rooms').child($room).child('heroes').child($slot).child('owner').val() === auth.uid)",
                ".validate": "newData.val() === 1 && $id.matches(/^(?:[0-9]|1[0-9])$/)"
              }
            },
            "equippedAccessories": {
              "$id": {
                ".write": "auth != null && (root.child('rooms').child($room).child('hostUid').val() === auth.uid || root.child('rooms').child($room).child('heroes').child($slot).child('owner').val() === auth.uid)",
                ".validate": "newData.val() === 1 && $id.matches(/^(?:[0-9]|1[0-9])$/)"
              }
            }
          }
        },
        "history": {
          "$entry": {
            ".write": "auth != null && !data.exists() && $entry.matches(/^[0-9]+_[a-zA-Z0-9_]+$/)",
            ".validate": "newData.hasChildren(['message','time']) && newData.child('message').isString() && newData.child('message').val().length <= 300 && newData.child('time').isNumber()"
          }
        }
      }
    }
  }
}
